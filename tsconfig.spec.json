{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "declarationMap": false,
    "rootDir": "./",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*.ts"],
  "exclude": ["node_modules", ".vscode", "dist"]
}
